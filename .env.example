# Smart AgroGuide - Environment Configuration

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/smart-agroguide
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/smart-agroguide

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_characters

# OpenAI Configuration (for AI recommendations)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Weather API Configuration (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@smartagroguide.com

# Redis Configuration (for caching and real-time features)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif
UPLOAD_DIR=./public/uploads

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Feature Flags
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_WEATHER_API=true
ENABLE_DISEASE_DETECTION=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_REAL_TIME_CHAT=true

# Prediction Engine Configuration
MIN_HISTORICAL_DATA_POINTS=5
PREDICTION_CONFIDENCE_THRESHOLD=0.6

# Analytics Configuration
ANALYTICS_RETENTION_DAYS=365

# Crop Configuration (customize for your region)
PRIMARY_CROPS=rice,wheat,cotton,tomato,potato
GROWING_SEASONS=kharif,rabi,summer
